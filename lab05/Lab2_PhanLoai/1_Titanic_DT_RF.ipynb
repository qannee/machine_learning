import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from sklearn import tree
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (
    ConfusionMatrixDisplay,
    accuracy_score,
    classification_report,
    confusion_matrix,
    roc_auc_score,
)
from sklearn.model_selection import GridSearchCV, train_test_split

# ===== 1. NẠP VÀ KHÁM PHÁ DỮ LIỆU =====
# Đảm bảo file titanic.csv nằm đúng đường dẫn (ví dụ trong thư mục ../data/ hoặc cùng cấp)
df = pd.read_csv("../data/titanic.csv")
print("Kích thước tập dữ liệu:", df.shape)
print(df.info())
print(df.isnull().sum())

# ===== 2. TIỀN XỬ LÝ DỮ LIỆU (THEO ĐÚNG BÁO CÁO) =====
data = df.copy()

# Điền giá trị thiếu
data["Age"] = data["Age"].fillna(
    data["Age"].median()
)  # Age thiếu 177 giá trị -> điền median
data["Embarked"] = data["Embarked"].fillna(
    data["Embarked"].mode()[0]
)  # Embarked thiếu 2 giá trị -> điền mode

# Xóa cột Cabin vì thiếu quá nhiều (687 giá trị)
if "Cabin" in data.columns:
  data = data.drop(columns=["Cabin"])

# Mã hóa giới tính Sex: male = 0, female = 1
data["Sex"] = data["Sex"].map({"male": 0, "female": 1})

# Mã hóa cảng lên tàu Embarked: S = 0, C = 1, Q = 2
embarked_mapping = {"S": 0, "C": 1, "Q": 2}
data["Embarked"] = data["Embarked"].map(embarked_mapping)

# Tạo thêm đặc trưng quy mô gia đình: FamilySize = SibSp + Parch + 1
data["FamilySize"] = data["SibSp"] + data["Parch"] + 1

# Lựa chọn các đặc trưng sử dụng theo báo cáo
features_to_use = [
    "Pclass",
    "Sex",
    "Age",
    "SibSp",
    "Parch",
    "Fare",
    "Embarked",
    "FamilySize",
    "Survived",
]
data = data[features_to_use]

# Tách biến độc lập (X) và biến mục tiêu (y)
X = data.drop(columns=["Survived"])
y = data["Survived"]
feature_names = X.columns.tolist()

# Chia train/test = 80/20, phân tầng theo Survived (stratify), random_state = 42
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, stratify=y, random_state=42
)
print(f"Kích thước tập Train: {X_train.shape}, Test: {X_test.shape}")

# ===== 3. CÂY QUYẾT ĐỊNH (DECISION TREE) & GRIDSEARCHCV =====
# Lưới tham số: max_depth ∈ {2,3,4,5,6,8,10}, min_samples_split ∈ {2,5,10}
dt_params = {
    "max_depth": [2, 3, 4, 5, 6, 8, 10],
    "min_samples_split": [2, 5, 10],
}

cv_dt = GridSearchCV(
    tree.DecisionTreeClassifier(random_state=42),
    dt_params,
    scoring="accuracy",
    cv=5,
    refit=True,
)
cv_dt.fit(X_train, y_train)

print("\n--- KẾT QUẢ TỐI ƯU DECISION TREE ---")
print("Best params:", cv_dt.best_params_)
print(f"CV accuracy ≈ {cv_dt.best_score_:.3f}")
test_acc_dt = accuracy_score(y_test, cv_dt.best_estimator_.predict(X_test))
print(f"Accuracy trên tập test ≈ {test_acc_dt:.3f}")

# Minh họa cấu trúc Cây quyết định với max_depth = 4 (Hình 2.1.2)
dt_vis = tree.DecisionTreeClassifier(max_depth=4, random_state=42).fit(
    X_train, y_train
)
plt.figure(figsize=(16, 8))
tree.plot_tree(
    dt_vis,
    feature_names=feature_names,
    class_names=["Died", "Survived"],
    filled=True,
    rounded=True,
    proportion=True,
)
plt.title("Hình 2.1.2 – Cây quyết định Titanic (max_depth = 4)")
plt.show()

# ===== 4. RÙNG CÂY (RANDOM FOREST) & GRIDSEARCHCV =====
# Lưới tham số: n_estimators ∈ {50,100,150}, max_depth ∈ {4,6,8}
rf_params = {"n_estimators": [50, 100, 150], "max_depth": [4, 6, 8]}

cv_rf = GridSearchCV(
    RandomForestClassifier(random_state=42),
    rf_params,
    scoring="accuracy",
    cv=5,
    refit=True,
)
cv_rf.fit(X_train, y_train)

print("\n--- KẾT QUẢ TỐI ƯU RANDOM FOREST ---")
print("Best params:", cv_rf.best_params_)
print(f"CV accuracy ≈ {cv_rf.best_score_:.3f}")
test_acc_rf = accuracy_score(y_test, cv_rf.best_estimator_.predict(X_test))
print(f"Accuracy trên tập test ≈ {test_acc_rf:.3f}")

# ===== 5. TẦM QUAN TRỌNG ĐẶC TRƯNG (FEATURE IMPORTANCE) =====
best_rf = cv_rf.best_estimator_
feat_imp = pd.Series(best_rf.feature_importances_, index=feature_names).sort_values(
    ascending=True
)

print("\n--- Feature Importance của Random Forest ---")
print(feat_imp.sort_values(ascending=False))

# Vẽ biểu đồ Feature Importance (Hình 2.1.3)
plt.figure(figsize=(8, 5))
feat_imp.plot.barh(color="skyblue")
plt.title("Hình 2.1.3 – Feature importance của Random Forest")
plt.xlabel("Importance Score")
plt.ylabel("Features")
plt.tight_layout()
plt.show()

# ===== 6. ĐÁNH GIÁ MÔ HÌNH TRÊN TẬP TEST & MA TRẬN NHẦM LẪN =====
models = {"Decision Tree": cv_dt.best_estimator_, "Random Forest": best_rf}

fig, axes = plt.subplots(1, 2, figsize=(10, 4))
for ax, (name, model) in zip(axes, models.items()):
  pred = model.predict(X_test)
  proba = model.predict_proba(X_test)[:, 1]

  print(f"\n===== ĐÁNH GIÁ MÔ HÌNH: {name} =====")
  print("Confusion Matrix:")
  print(confusion_matrix(y_test, pred))
  print("\nClassification Report:")
  print(
      classification_report(y_test, pred, target_names=["Died", "Survived"])
  )
  print(f"ROC-AUC Score: {roc_auc_score(y_test, proba):.4f}")

  # Vẽ Ma trận nhầm lẫn (Hình 2.1.4)
  ConfusionMatrixDisplay.from_predictions(y_test, pred, ax=ax, cmap="Blues")
  ax.set_title(f"Confusion Matrix - {name}")

plt.tight_layout()
plt.show()
