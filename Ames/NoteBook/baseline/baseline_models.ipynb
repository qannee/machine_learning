   "source": [
    "DATA = Path('../../data/processed')\n",
    "OUT = Path('../../../outputdata')\n",
    "OUT.mkdir(exist_ok=True)\n",
    "\n",
    "X_train = pd.read_csv(DATA / 'X_train.csv')\n",
    "X_valid = pd.read_csv(DATA / 'X_test.csv')\n",
    "X_kaggle = pd.read_csv(DATA / 'X_kaggle_test.csv')\n",
    "y_train = pd.read_csv(DATA / 'y_train.csv')['SalePrice']\n",
    "y_valid = pd.read_csv(DATA / 'y_test.csv')['SalePrice']\n",
    "ids = pd.read_csv('../../data/raw/sample_submission.csv')['Id']\n",
    "\n",
    "print(X_train.shape, X_valid.shape, X_kaggle.shape)\n",
    "assert (X_train.columns == X_kaggle.columns).all()\n",
    "assert len(ids) == len(X_kaggle)"
   ]
